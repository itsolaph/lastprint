# Lastprint keeper configuration. Copy to .env and adjust. Never commit a real .env.

# HTTP server (loopback by default; put a reverse proxy in front for public use)
HOST=127.0.0.1
PORT=18797
PUBLIC_URL=http://127.0.0.1:18797

# Base mainnet RPC (read + send). Public endpoints rate-limit; the keeper backs off on 429.
RPC_URL=https://base.drpc.org
CHAIN_ID=8453

# Deployed LastprintOrders. Leave empty to run read-only (markets and gaps only, ordering disabled).
LASTPRINT_ADDRESS=
# Block the contract was deployed in; the event indexer starts here.
LASTPRINT_DEPLOY_BLOCK=0
# Max block range per eth_getLogs call (halved automatically on rate limits).
LOG_RANGE_BLOCKS=2000

# Keeper signer. Optional: without it the keeper runs watch-only (simulates fills, never sends).
# Use a dedicated hot wallet holding only gas money. Never logged.
KEEPER_PRIVATE_KEY=

# Venue (defaults: Aerodrome Slipstream V3 on Base; must be in the contract's router allowlist)
# ROUTER=0x9Ee35Bf1bd69a03c6F0393582030fCe8Bb93D418
# META_QUOTER=0x1dDfeC5058180C207F55BB77D95AcDd0d8227868
# ACTION_FEED=0xC455472cd39029F8309F0D762Ee587D65A596Fe2

# Keeper loop
LOOP_INTERVAL_MS=5000
# Fill only when quote >= minAmountOut * (1 + SAFETY_BPS / 10000)
SAFETY_BPS=15
# Gas caps (Base). Fills are skipped and retried later if the network is above the cap.
MAX_FEE_GWEI=0.5
MAX_PRIORITY_FEE_GWEI=0.01
GAS_LIMIT_CAP=900000
# Reference trade size for displayed Base quotes, in USD
REFERENCE_USD=1000

# Storage
DB_PATH=data/lastprint.sqlite
MARKETS_PATH=markets.json

# Optional Telegram bot (/start <address>, /gap). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

REPO_URL=https://github.com/itsolaph/lastprint

# Screenshots / gap report: Chromium binary (defaults to the Playwright cache)
# CHROMIUM_PATH=
